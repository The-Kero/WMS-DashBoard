      <condition>v10 설계서에서 추가 데이터 필요로 판단된 경우</condition>
      <file>C:\Projects\WMS-DashBoard\flask_app\api\dashboard.py</file>
    </step>
    
    <step id="3" duration="2-3시간">
      <title>dashboard.html 작성</title>
      <file>C:\Projects\WMS-DashBoard\flask_app\templates\dashboard.html</file>
      
      <jinja2_patterns>
        <pattern type="단순값">
          <before>&lt;div class="value">67&lt;/div></before>
          <after>&lt;div class="value">{{ card2.totalCount }}&lt;/div></after>
        </pattern>
        
        <pattern type="반복문">
          <before>&lt;div class="item">...&lt;/div></before>
          <after>
{% for item in card3.riskyItems %}
  &lt;div class="item">{{ item.productName }}&lt;/div>
{% endfor %}
          </after>
        </pattern>
        
        <pattern type="조건부">
          <before>&lt;div class="status-urgent">긴급&lt;/div></before>
          <after>
{% if item.validityRatio &lt;= 10 %}
  &lt;div class="status-urgent">긴급&lt;/div>
{% endif %}
          </after>
        </pattern>
        
        <pattern type="숫자포맷">
          <jinja>{{ "{:,}".format(card5.amount) }}</jinja>
          <result>61,777,004</result>
        </pattern>
        
        <pattern type="날짜포맷">
          <description>YYYYMMDD → YY.MM.DD</description>
          <jinja>{{ item.expiryDate[2:4] }}.{{ item.expiryDate[4:6] }}.{{ item.expiryDate[6:8] }}</jinja>
          <example>20251204 → 25.12.04</example>
        </pattern>
      </jinja2_patterns>
    </step>
    
    <step id="4" duration="1-2시간">
      <title>dashboard.css 작성</title>
      <file>C:\Projects\WMS-DashBoard\flask_app\static\css\dashboard.css</file>
      
      <requirements>
        <req>v10 그리드 시스템 (설계에 따라)</req>
        <req>큰 숫자: font-size 72px 이상</req>
        <req>카드 타이틀: font-size 32px 이상</req>
        <req>색상 대비율: 5:1 이상</req>
      </requirements>
    </step>
    
    <step id="5" duration="15분">
      <title>Flask 라우트 연결</title>
      <file>C:\Projects\WMS-DashBoard\flask_app\app.py</file>
      <code>
from flask import render_template

@app.route('/')
def index():
    return render_template('dashboard.html')
      </code>
    </step>
    
    <step id="6" duration="30분">
      <title>통합 테스트</title>
      <tests>
        <test>Flask 서버 실행</test>
        <test>localhost:5000 접속</test>
        <test>모든 카드 표시 확인</test>
        <test>데이터 정확성 검증</test>
        <test>F12 콘솔 에러 확인</test>
      </tests>
    </step>
    
    <step id="7" duration="15분">
      <title>Git 커밋</title>
      <commands>
        <cmd>git add .</cmd>
        <cmd>git commit -m "Phase 2 Day 4: v10 레이아웃 HTML 완성"</cmd>
      </commands>
    </step>
  </day4_process>
  
