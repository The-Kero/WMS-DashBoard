        // 긴급알림 소리 재생 (1번: 붕— 붕— 붕— 붕— 붕—)
        function playAlertSound() {
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            for (let i = 0; i < 5; i++) {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, audioCtx.currentTime + i * 1.0);
                gain.gain.setValueAtTime(0, audioCtx.currentTime + i * 1.0);
                gain.gain.linearRampToValueAtTime(0.45, audioCtx.currentTime + i * 1.0 + 0.06);
                gain.gain.setValueAtTime(0.4, audioCtx.currentTime + i * 1.0 + 0.42);
                gain.gain.linearRampToValueAtTime(0, audioCtx.currentTime + i * 1.0 + 0.6);
                osc.start(audioCtx.currentTime + i * 1.0);
                osc.stop(audioCtx.currentTime + i * 1.0 + 0.65);
            }
        }

