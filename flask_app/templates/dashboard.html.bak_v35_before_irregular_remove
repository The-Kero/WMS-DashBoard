                    `;
                } else {
                    // 3열 레이아웃: 인덱스 % 3으로 분리
                    const leftItems = items.filter((_, i) => i % 3 === 0);
                    const midItems = items.filter((_, i) => i % 3 === 1);
                    const rightItems = items.filter((_, i) => i % 3 === 2);
                    
                    const leftRows = leftItems.map(item => {
                        const inboundInfo = formatCard5InboundInfo(item.inbound_info);
                        return `<tr><td class="left">${item.product_name}</td><td class="left">${inboundInfo}</td></tr>`;
                    }).join('');
                    
                    const midRows = midItems.map(item => {
                        const inboundInfo = formatCard5InboundInfo(item.inbound_info);
                        return `<tr><td class="left">${item.product_name}</td><td class="left">${inboundInfo}</td></tr>`;
                    }).join('');
                    
                    const rightRows = rightItems.map(item => {
                        const inboundInfo = formatCard5InboundInfo(item.inbound_info);
                        return `<tr><td class="left">${item.product_name}</td><td class="left">${inboundInfo}</td></tr>`;
                    }).join('');
                    
                    contentContainer.innerHTML = `
                        <div class="card5-unallocated-section">
                            <div class="section-header" style="border-bottom-color: #3B82F6;">
                                <div class="section-title" style="color: #3B82F6;">📦 미할당 ${items.length}건</div>
                            </div>
                            <div class="card5-three-column">
                                <table class="card5-unallocated-table">
                                    <thead><tr><th>상품명</th><th>입고센터</th></tr></thead>
                                    <tbody>${leftRows}</tbody>
                                </table>
                                <table class="card5-unallocated-table">
                                    <thead><tr><th>상품명</th><th>입고센터</th></tr></thead>
                                    <tbody>${midRows}</tbody>
                                </table>
                                <table class="card5-unallocated-table">
                                    <thead><tr><th>상품명</th><th>입고센터</th></tr></thead>
                                    <tbody>${rightRows}</tbody>
                                </table>
                            </div>
                        </div>
                    `;
                }
            } else {
                // ========================================
                // 18:30 이전: 피킹 유의상품 표시 (기존 로직)
                // ========================================
                
                // 스타일 복원 (빨간 테두리)
                card5El.classList.add('ingWarning');
                
                // 제목 복원
                card5Title.textContent = '⚠️ 금일 피킹 유의 상품';
                
                // 기존 피킹 유의상품 렌더링
                contentContainer.innerHTML = `
                    <div class="risky-section">
                        <div class="section-header">
                            <div class="section-title">🚨 유효비 20% 이하</div>
                            <div class="section-count" id="pickingRiskyCount">${data.totalCount}건</div>
                        </div>
                        <div class="risky-list" id="pickingRiskyList"></div>
                    </div>
                `;
                
                const listContainer = document.getElementById('pickingRiskyList');
                
                if (data.totalCount === 0) {
                    listContainer.innerHTML = `
                        <div style="text-align: center; padding: 30px; color: #60CB2E; font-size: 18px; grid-column: span 2;">
                            ✅ 피킹 유의상품 없음
                        </div>
                    `;
                } else {
                    data.riskyItems.slice(0, 12).forEach(item => {
                        const badgeClass = item.validityRatio <= 10 ? 'urgent' : 'warning';
                        const ratioText = item.validityRatio + '%';
                        
                        const itemDiv = document.createElement('div');
                        itemDiv.className = 'risky-item';
                        itemDiv.innerHTML = `
                            <span class="picking-badge ${badgeClass}">${ratioText}</span>
                            <span class="picking-location">${item.location}</span>
                            <span class="picking-name">${item.productName}</span>
                            <span class="picking-expiry-date">${item.expiryDate}</span>
                        `;
                        listContainer.appendChild(itemDiv);
                    });
                }
            }
        }
        
        // 카드5용 입고예정 정보 포맷팅 (센터명만 표시)
        function formatCard5InboundInfo(infoStr) {
            if (!infoStr || infoStr === '⏳입고정보 대기중') {
                return '<span style="color: #9CA3AF;">⏳대기중</span>';
