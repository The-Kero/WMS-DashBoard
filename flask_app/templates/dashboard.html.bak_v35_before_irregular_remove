    <script>
        // ========================================
        // 전역 변수 (스크립트 최상단)
        // ========================================
        let lastRefreshTime = null;  // 마지막 갱신 시각 (경과 시간 표시용)
        
        // ========================================
        // 시계
        // ========================================
        function updateTime() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('ko-KR', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });
            const dateStr = now.toLocaleDateString('ko-KR', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                weekday: 'short'
            });
            document.getElementById('currentTime').textContent = `${dateStr} ${timeStr}`;
            
            // 마지막 갱신 경과 시간 표시
            const lastUpdateEl = document.getElementById('lastUpdate');
            if (lastRefreshTime && lastUpdateEl) {
                const elapsed = Math.floor((now - lastRefreshTime) / 1000);
                let text;
                if (elapsed < 60) {
                    text = '방금';
                } else {
                    const minutes = Math.floor(elapsed / 60);
                    text = `${minutes}분 전`;
                }
                lastUpdateEl.textContent = text;
            }
        }
        updateTime();
        setInterval(updateTime, 1000);
        
        // ========================================
        // 카드2: 입고현황 업데이트
        // ========================================
        function updateCard1(data) {
            // 총 건수 (숫자만 - HTML에 단위 있음)
            document.getElementById('totalCount').textContent = data.totalCount;
            
            // 진척률 (숫자만 - HTML에 % 있음)
            document.getElementById('progressRate').textContent = data.progressRate;
            
            // 프로그레스바 (폭 + 색상)
            const progressBar = document.getElementById('progressBar');
            progressBar.style.width = data.progressRate + '%';
            
            // 진척률별 색상 클래스 적용 (빨강→주황→노랑→초록)
            progressBar.classList.remove('level-danger', 'level-warning', 'level-caution', 'level-good');
            if (data.progressRate < 25) {
                progressBar.classList.add('level-danger');      // 빨강
            } else if (data.progressRate < 50) {
                progressBar.classList.add('level-warning');     // 주황
            } else if (data.progressRate < 75) {
                progressBar.classList.add('level-caution');     // 노랑
            } else {
                progressBar.classList.add('level-good');        // 초록
            }
            
            // 유의상품 건수
            document.getElementById('inboundRiskyCount').textContent = data.inboundRiskyCount + '건';
            
            // 유의상품 리스트
            const listContainer = document.getElementById('inboundRiskyList');
            listContainer.innerHTML = '';
            
            if (data.inboundRiskyCount === 0) {
                listContainer.innerHTML = `
                    <div style="text-align: center; padding: 30px; color: #60CB2E; font-size: 18px;">
                        ✅ 입고 유의상품 없음
                    </div>
                `;
            } else {
                data.riskyItems.forEach(item => {
                    const itemDiv = document.createElement('div');
                    itemDiv.className = 'risky-item';
                    
                    const formatDate = (dateStr) => {
                        if (!dateStr || dateStr.length !== 8) return dateStr;
                        return dateStr.substring(2,4) + '.' + dateStr.substring(4,6) + '.' + dateStr.substring(6,8);
                    };
                    
                    itemDiv.innerHTML = `
                        <div class="item-header">
                            <span class="item-icon">🔴</span>
                            <span class="item-name">${item.productName}</span>
                        </div>
                        <div class="item-details">
                            입고분 : <span style="color: #EF4444; font-weight: 600;">${formatDate(item.inboundExpiry)}</span><span class="separator">|</span>기존 : <span style="color: #3B82F6; font-weight: 600;">${formatDate(item.stockExpiry)}</span>
                        </div>
                    `;
                    listContainer.appendChild(itemDiv);
                });
            }
        }
        
        // ========================================
        // 카드4: 스케줄 업데이트 (날짜 그룹핑 + 순서 스타일)
        // ========================================
        function updateCard4(data) {
            const container = document.querySelector('#card4 .schedule-content-main');
            if (!container) return;
            
            const typeIcons = {
                birthday: '🎂',
                leave: '🏖️',
                education: '📚',
                event: '📌'
            };
            
            const typeNames = {
                birthday: '생일',
                leave: '월차',
                education: '교육',
                event: '행사'
            };
            
            const dayNames = ['일', '월', '화', '수', '목', '금', '토'];
            
            // 날짜 포맷 함수 (M/DD 요일)
            function formatDate(dateStr) {
                const d = new Date(dateStr + 'T00:00:00');
                const month = d.getMonth() + 1;
                const day = d.getDate();
                const dayName = dayNames[d.getDay()];
                return `${month}/${String(day).padStart(2,'0')} (${dayName})`;
            }
            
            const schedules = data.schedules || [];
            
            if (schedules.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 40px; color: #A0AEC0; font-size: 16px;">
                        📅 예정된 일정이 없습니다
                    </div>
                `;
                return;
            }
            
            // 날짜별로 그룹핑
            const dateGroups = {};
            schedules.forEach(item => {
                if (!dateGroups[item.date]) {
                    dateGroups[item.date] = [];
                }
                dateGroups[item.date].push(item);
            });
            
            // 날짜순 정렬
            const sortedDates = Object.keys(dateGroups).sort();
            
            // 타입별로 이름 합치는 함수
            function groupByType(items) {
                const typeGroups = {};
                items.forEach(item => {
                    const type = item.type || 'event';
                    if (!typeGroups[type]) {
                        typeGroups[type] = [];
                    }
                    typeGroups[type].push(item.content);
                });
                return typeGroups;
            }
            
            // 타입별 그룹을 HTML로 변환하는 함수
            function renderTypeGroups(typeGroups, suffix = '') {
                return Object.keys(typeGroups).map(type => {
                    const names = typeGroups[type].join(', ');
                    const icon = typeIcons[type] || '📌';
                    const typeName = typeNames[type] || '';
                    return `
                        <div class="event-item ${type}">
                            <span class="event-icon">${icon}</span>
                            <span class="event-text">${names} ${typeName}${suffix}</span>
                        </div>
                    `;
                }).join('');
            }
            
            let html = '';
            
            sortedDates.forEach((date, dateIndex) => {
                const items = dateGroups[date];
                const dateText = formatDate(date);
                const typeGroups = groupByType(items);
                
                // 첫번째 날짜=노란색, 두번째 날짜=파란색, 나머지=추후일정으로 모음
                if (dateIndex === 0) {
                    // 첫번째 날짜 - 노란색
                    html += `
                        <div class="schedule-group today">
                            <div class="group-title">
                                <span class="group-title-text">${dateText}</span>
                                <span class="group-count">${items.length}건</span>
                            </div>
                            <div class="event-list">
                                ${renderTypeGroups(typeGroups)}
                            </div>
                        </div>
                    `;
                } else if (dateIndex === 1) {
                    // 두번째 날짜 - 파란색
                    html += `
                        <div class="schedule-group tomorrow">
                            <div class="group-title">
                                <span class="group-title-text">${dateText}</span>
                                <span class="group-count">${items.length}건</span>
                            </div>
                            <div class="event-list">
                                ${renderTypeGroups(typeGroups)}
                            </div>
                        </div>
                    `;
                }
            });
            
            // 추후일정 (3번째 날짜 이후)
            const laterDates = sortedDates.slice(2);
            if (laterDates.length > 0) {
                let totalLaterCount = 0;
                let laterHtml = '';
                
                laterDates.forEach(date => {
                    const items = dateGroups[date];
                    totalLaterCount += items.length;
                    const dateText = formatDate(date);
                    const typeGroups = {};
                    
                    items.forEach(item => {
                        const type = item.type || 'event';
                        if (!typeGroups[type]) {
                            typeGroups[type] = [];
                        }
                        // 이름에서 요일 패턴 제거
                        const cleanContent = item.content.replace(/\([일월화수목금토]\)/, '');
                        typeGroups[type].push(cleanContent);
                    });
                    
                    // 각 타입별로 날짜 태그 붙여서 렌더링
                    Object.keys(typeGroups).forEach(type => {
                        const names = typeGroups[type].join(', ');
                        const icon = typeIcons[type] || '📌';
                        const typeName = typeNames[type] || '';
                        laterHtml += `
                            <div class="event-item ${type}">
                                <span class="event-icon">${icon}</span>
                                <span class="event-text">${names} ${typeName} [ ${dateText} ]</span>
                            </div>
                        `;
                    });
                });
                
                html += `
                    <div class="schedule-group this-week">
                        <div class="group-title">
                            <span class="group-title-text">추후일정</span>
                            <span class="group-count">${totalLaterCount}건</span>
                        </div>
                        <div class="event-list">
                            ${laterHtml}
                        </div>
                    </div>
                `;
            }
            
            container.innerHTML = html;
        }
        
        // ========================================
        // 카드5: 피킹유의 / 미할당 입고현황 (18:30 기준 전환)
        // ========================================
        
        // 센터명 → 클래스명 매핑 (카드5 미할당용)
        const card5CenterClassMap = {
            '안산': 'ansan', '음성': 'eumseong', '제주': 'jeju', '제천': 'jecheon',
            '호남': 'honam', '구미': 'gumi', '계룡': 'gyeryong', '용인': 'yongin', '양산': 'yangsan'
        };
        
