        // ========================================
        // API 호출 함수
        // ========================================
        
        async function fetchDashboardData() {
            const now = new Date();
            const timeStr = now.toTimeString().slice(0, 8);
            console.log(`[${timeStr}] API 호출 시작...`);
            
            try {
                // URL 파라미터 전달 (test_alert 등)
                const urlParams = window.location.search;
                const response = await fetch('/api/dashboard' + urlParams);
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                
                const data = await response.json();
                
                if (!data.success) {
                    throw new Error(data.error || 'API 실패');
                }
                
                // 데이터 저장 (실패 시 복구용)
                lastData = data;
                
                // 카드 업데이트
                updateCard1(data.card1);
                updateCard2(data.card2);
                updateCard3(data.card3);
                updateCard4(data.card4);
                updateCard5(data.card5);
                updateCard6(data.card6);
                
                // 마지막 갱신 시각 저장
                lastRefreshTime = new Date();
                
                console.log(`[${timeStr}] ✅ 대시보드 갱신 완료`);
                
            } catch (error) {
                console.error(`[${timeStr}] ❌ API 호출 실패:`, error.message);
                
                // 이전 데이터가 있으면 유지 (화면 빈칸 방지)
                if (lastData) {
                    console.log(`[${timeStr}] 이전 데이터 유지`);
                }
            }
        }
        
        // ========================================
        // 자동 갱신 제어
        // ========================================
        
        function startAutoRefresh() {
            // 기존 타이머 정리
            if (refreshTimer) {
                clearInterval(refreshTimer);
            }
            
            // 5분마다 갱신
            refreshTimer = setInterval(() => {
                // 운영 시간 재확인 (혹시 모를 상황 대비)
                const status = isOperatingTime();
                if (status.operating) {
                    fetchDashboardData();
                } else {
                    console.log('[SKIP] 운영 시간 외 - 갱신 건너뜀');
                }
            }, REFRESH_INTERVAL);
            
            console.log('[AUTO] 5분 간격 자동 갱신 시작');
        }
        
        function stopAutoRefresh() {
            if (refreshTimer) {
                clearInterval(refreshTimer);
                refreshTimer = null;
                console.log('[AUTO] 자동 갱신 중지');
            }
        }
        
        // ========================================
        // 스케줄링 함수
        // ========================================
        
        // 다음 갱신 시간에 맞춰 시작
        function scheduleNextRefresh() {
            const nextTime = getNextRefreshTime();
            const msUntil = nextTime.getTime() - Date.now();
            const nextTimeStr = nextTime.toTimeString().slice(0, 8);
            
            console.log(`[SCHEDULE] 다음 갱신: ${nextTimeStr} (${Math.round(msUntil/1000)}초 후)`);
            
            setTimeout(() => {
                fetchDashboardData();
                startAutoRefresh();
            }, msUntil);
        }
        
        // 운영 시간 시작까지 대기
        function scheduleOperatingStart() {
            const msUntil = getMsUntilOperatingStart();
            const hours = Math.floor(msUntil / 1000 / 60 / 60);
            const minutes = Math.floor((msUntil / 1000 / 60) % 60);
            
            console.log(`[WAIT] 운영 시작까지 ${hours}시간 ${minutes}분 대기`);
            
            setTimeout(() => {
                hideOffTimeMessage();
                fetchDashboardData();
                startAutoRefresh();
            }, msUntil);
        }
        
        // 자정 새로고침 예약
        function scheduleMidnightReload() {
            const msUntil = getMsUntilMidnight();
            const hours = Math.floor(msUntil / 1000 / 60 / 60);
            const minutes = Math.floor((msUntil / 1000 / 60) % 60);
            
            console.log(`[MIDNIGHT] 자정 새로고침 예약 (${hours}시간 ${minutes}분 후)`);
            
            setTimeout(() => {
                console.log('[MIDNIGHT] 자정 새로고침 실행!');
                location.reload();
            }, msUntil);
        }
        
        // ========================================
        // 초기화
        // ========================================
        
        function init() {
            console.log('========================================');
            console.log('WMS 대시보드 초기화');
            console.log('========================================');
            
            // 1. 자정 새로고침 예약 (항상)
            scheduleMidnightReload();
            
            // 2. 운영 시간 체크
            const status = isOperatingTime();
            
            if (!status.operating) {
                // 운영 시간 외
                showOffTimeMessage(status.reason);
                
                if (status.reason === 'holiday') {
                    // 토요일: 자정 새로고침까지 대기 (이미 예약됨)
                    console.log('[HOLIDAY] 토요일 - 자정까지 대기');
                } else {
                    // 09시 전: 09:02까지 대기
                    scheduleOperatingStart();
                }
            } else {
                // 운영 시간 중
                console.log('[OPERATING] 운영 시간 중 - 즉시 시작');
                
                // 오버레이 숨기기
                hideOffTimeMessage();
                
                // 즉시 첫 데이터 로드
                fetchDashboardData();
                
                // 다음 X분 2초에 맞춰 스케줄링
                scheduleNextRefresh();
            }
        }
        
        // 페이지 로드 시 초기화
        window.addEventListener('DOMContentLoaded', init);
    </script>
    
    <!-- 긴급알림 팝업 -->
    <div id="urgentAlertPopup" class="urgent-popup" onclick="closeUrgentAlert()">
        <div class="urgent-popup-content" onclick="event.stopPropagation()">
            <div class="urgent-popup-title">🚨 지방출고 긴급알림</div>
            <div class="urgent-popup-message">미발행 피킹리스트 발생!</div>
            <div class="urgent-popup-dest" id="urgentAlertDestList"></div>
            <div class="urgent-popup-close" onclick="closeUrgentAlert()">클릭하여 닫기 (10초 후 자동 닫힘)</div>
        </div>
    </div>
    
</body>
</html>