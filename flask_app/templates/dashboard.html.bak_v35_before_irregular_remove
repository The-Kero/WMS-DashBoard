        // ========================================
        // 자동 갱신 시스템 (1분 간격, 운영시간 체크)
        // ========================================
        
        // 상수 정의
        const REFRESH_INTERVAL = 1 * 60 * 1000;  // 1분 (60,000ms)
        const REFRESH_OFFSET = 2;                 // X분 2초에 갱신
        const OPERATING_START_HOUR = 9;           // 09시 시작
        const OPERATING_END_HOUR = 24;            // 24시 종료
        const OFF_DAY = 6;                        // 토요일 (0=일, 6=토)
        
        // 전역 변수
        let refreshTimer = null;
        let lastData = null;  // API 실패 시 이전 데이터 유지용
        // lastRefreshTime은 스크립트 최상단에 선언됨
        
        // ========================================
        // 유틸리티 함수
        // ========================================
        
        // 운영 시간 체크
        function isOperatingTime() {
            const now = new Date();
            const hour = now.getHours();
            const day = now.getDay();  // 0=일, 6=토
            
            // 토요일은 휴무
            if (day === OFF_DAY) {
                return { operating: false, reason: 'holiday' };
            }
            
            // 09시 ~ 24시 운영
            if (hour >= OPERATING_START_HOUR && hour < OPERATING_END_HOUR) {
                return { operating: true, reason: null };
            }
            
            return { operating: false, reason: 'before_start' };
        }
        
        // 다음 갱신 시간 계산 (X분 2초)
        function getNextRefreshTime() {
            const now = new Date();
            const minutes = now.getMinutes();
            const seconds = now.getSeconds();
            
            // 다음 5분 단위 + 2초 계산
            // 예: 현재 09:03:45 → 다음은 09:07:02
            const currentSlot = Math.floor(minutes / 5) * 5;
            let nextSlot = currentSlot + 5;
            
            // 이미 X분 2초를 지났으면 다음 슬롯
            if (minutes % 5 > REFRESH_OFFSET || (minutes % 5 === REFRESH_OFFSET && seconds >= 2)) {
                nextSlot += 5;
            }
            
            const nextTime = new Date(now);
            if (nextSlot >= 60) {
                nextTime.setHours(now.getHours() + 1);
                nextSlot = nextSlot - 60;
            }
            nextTime.setMinutes(nextSlot + REFRESH_OFFSET);
            nextTime.setSeconds(2);
            nextTime.setMilliseconds(0);
            
            return nextTime;
        }
        
        // 09:02까지 남은 시간 계산
        function getMsUntilOperatingStart() {
            const now = new Date();
            const target = new Date(now);
            target.setHours(OPERATING_START_HOUR);
            target.setMinutes(REFRESH_OFFSET);
            target.setSeconds(2);
            target.setMilliseconds(0);
            
            // 이미 지났으면 내일
            if (target <= now) {
                target.setDate(target.getDate() + 1);
            }
            
            return target.getTime() - now.getTime();
        }
        
        // 자정까지 남은 시간 계산
        function getMsUntilMidnight() {
            const now = new Date();
            const midnight = new Date(now);
            midnight.setHours(24, 0, 0, 0);
            return midnight.getTime() - now.getTime();
        }
        
