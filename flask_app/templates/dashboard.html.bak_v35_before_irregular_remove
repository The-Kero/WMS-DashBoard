<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WMS 동서울물류센터 냉장파트</title>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Malgun Gothic', sans-serif;
            background: #E8EAED;
            width: 1920px;
            height: 1080px;
            overflow: hidden;
        }
        
        /* ========================================
           헤더
           ======================================== */
        .header {
            background: #3B4458;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            position: relative;
        }
        
        .header .leftSection {
            display: flex;
            align-items: center;
            gap: 15px;
            flex: 1;
        }
        
        .header .logoContainer {
            background: #3B4458;
            padding: 5px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .header .logo {
            height: 40px;
            width: auto;
            display: block;
        }
        
        .header h1 {
            font-size: 24px;
            color: #FFFFFF;
            font-weight: bold;
        }
        
        .header .updateInfo {
            font-size: 16px;
            color: #B0B8C4;
            margin-left: auto;
        }
        
        .header .centerSection {
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }
        
        .header .time {
            font-size: 20px;
            color: #FFFFFF;
            font-weight: bold;
        }
        
        /* ========================================
           메인 컨테이너
           ======================================== */
        .mainList {
            padding: 20px;
            height: calc(1080px - 60px);
            display: flex;
            gap: 20px;
        }
        
        /* 좌측 카드 영역 (3x2 그리드) */
        .cardsSection {
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .cardRow {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }
        
        /* 우측 알림 로그 영역 */
        .rightSection {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        /* ========================================
           카드 기본 스타일
           ======================================== */
        .gaugeItem {
            background: #FFFFFF;
            border: 2px solid #D1D5DB;
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            width: 360px;
            height: 480px;
        }
        
        /* 카드6 전용 스타일 (우측 큰 카드) */
        #card6 {
            width: 100% !important;
            height: 100% !important;
        }
        
        #card6 h2 {
            font-size: 26px;
            margin-bottom: 20px;
        }
        
        .card6-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        /* 경고 상태 */
        .gaugeItem.ingWarning {
            background: #FFF5F5;
            border: 4px solid #F05E5E;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(240, 94, 94, 0.4);
            }
            50% {
                box-shadow: 0 0 0 10px rgba(240, 94, 94, 0);
            }
        }
        
        /* 제목 */
        .gaugeItem h2 {
            font-size: 18px;
            color: #4B5563;
            font-weight: 600;
            margin-bottom: 15px;
            text-align: center;
        }
        
        .gaugeItem.ingWarning h2 {
            color: #F05E5E;
        }
        
        /* 18시 이전 안내 문구 */
        #card6 .before-18-notice {
            background: #F3F4F6;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            color: #9CA3AF;
            font-size: 16px;
        }
        
        #card6 .before-18-notice .notice-icon {
            font-size: 24px;
            margin-bottom: 8px;
        }
        
        /* ========================================
           카드 2: 입고 현황
           ======================================== */
        .inbound-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .metrics-section {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #E8EAED;
        }
        
        .metric-box {
            flex: 1;
            text-align: center;
        }
        
        .metric-label {
            font-size: 13px;
            color: #666;
            margin-bottom: 8px;
        }
        
        .metric-value {
            font-size: 32px;
            font-weight: bold;
            color: #3B4458;
        }
        
        .metric-unit {
            font-size: 18px;
            color: #999;
            margin-left: 6px;
        }
        
        .progress-bar-container {
            margin-top: 8px;
            width: 100%;
            height: 6px;
            background: #E8EAED;
            border-radius: 3px;
            overflow: hidden;
        }
        
        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #60CB2E 0%, #7DD956 50%, #60CB2E 100%);
            background-size: 200% 100%;
            transition: width 0.8s ease-out;
            animation: shimmer 2s infinite linear;
            border-radius: 3px;
        }
        
        @keyframes shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        
        /* 진척률별 프로그레스바 색상 */
        .progress-bar.level-danger {
            background: linear-gradient(90deg, #DC2626 0%, #EF4444 50%, #DC2626 100%);
            background-size: 200% 100%;
        }
        
        .progress-bar.level-warning {
            background: linear-gradient(90deg, #F97316 0%, #FB923C 50%, #F97316 100%);
            background-size: 200% 100%;
        }
        
        .progress-bar.level-caution {
            background: linear-gradient(90deg, #EAB308 0%, #FACC15 50%, #EAB308 100%);
            background-size: 200% 100%;
        }
        
        .progress-bar.level-good {
            background: linear-gradient(90deg, #60CB2E 0%, #7DD956 50%, #60CB2E 100%);
            background-size: 200% 100%;
        }
        
        /* 입고 유의상품 영역 */
        .risky-section {
            flex: 1;
            overflow-y: auto;
        }
        
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 2px solid #F05E5E;
        }
        
        .section-title {
            font-size: 16px;
            font-weight: bold;
            color: #F05E5E;
        }
        
        .section-count {
            font-size: 13px;
            background: #FEE2E2;
            color: #F05E5E;
            padding: 3px 10px;
            border-radius: 10px;
            font-weight: bold;
        }
        
        .risky-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 210px;
            overflow-y: auto;
            overflow-x: hidden;
            padding-right: 5px;
        }
        
        /* 스크롤바 스타일 */
        .risky-list::-webkit-scrollbar {
            width: 6px;
        }
        
        .risky-list::-webkit-scrollbar-track {
            background: #F3F4F6;
            border-radius: 3px;
        }
        
        .risky-list::-webkit-scrollbar-thumb {
            background: #D1D5DB;
            border-radius: 3px;
        }
        
        .risky-list::-webkit-scrollbar-thumb:hover {
            background: #9CA3AF;
        }
        
        .risky-item {
            padding: 10px 12px;
            background: linear-gradient(135deg, #FFFBFB 0%, #FEF2F2 100%);
            border-left: 3px solid #F87171;
            border-radius: 6px;
            transition: all 0.2s ease;
        }
        
        .risky-item:hover {
            background: #FEF2F2;
            border-left-color: #DC2626;
            transform: translateX(3px);
        }
        
        .item-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 4px;
        }
        
        .item-icon {
            font-size: 16px;
        }
        
        .item-name {
            font-size: 14px;
            font-weight: 700;
            color: #1F2937;
        }
        
        .item-details {
            font-size: 12px;
            color: #6B7280;
            padding-left: 24px;
        }
        
        .item-details .separator {
            margin: 0 6px;
            color: #D1D5DB;
        }
        
        .item-details .date {
            color: #DC2626;
            font-weight: 600;
        }
        
        /* ========================================
           카드 5: 피킹 유의 상품 (740px 폭 확대!)
           ======================================== */
        .gaugeItem.card5-wide {
            width: 740px; /* 360px → 740px */
            grid-column: span 2; /* 2칸 차지 */
        }
        
        .picking-metrics {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #E8EAED;
        }
        
        .picking-metric-box {
            flex: 1;
            text-align: center;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #FCA5A5;
        }
        
        .picking-metric-box.total {
            background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
        }
        
        .picking-metric-box.urgent {
            background: linear-gradient(135deg, #FEE2E2 0%, #FEF2F2 100%);
        }
        
        .picking-metric-box.warning {
            background: linear-gradient(135deg, #FEF9C3 0%, #FEF3C7 100%);
            border-color: #FCD34D;
        }
        
        .picking-metric-label {
            font-size: 11px;
            color: #991B1B;
            margin-bottom: 6px;
            font-weight: 600;
        }
        
        .picking-metric-box.warning .picking-metric-label {
            color: #78350F;
        }
        
        .picking-metric-value {
            font-size: 28px;
            font-weight: bold;
            color: #DC2626;
        }
        
        .picking-metric-box.warning .picking-metric-value {
            color: #CA8A04;
        }
        
        /* 카드5 전용: 피킹 유의상품 리스트 (2열 그리드) */
        #card5 .risky-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            max-height: 400px;
        }
        
        #card5 .risky-item {
            padding: 8px 10px;
            background: linear-gradient(135deg, #FFFBFB 0%, #FEF2F2 100%);
            border-left: 3px solid #F87171;
            border-radius: 6px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        #card5 .risky-item:hover {
            background: #FEF2F2;
            border-left-color: #DC2626;
        }
        
        #card5 .picking-row1 {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        #card5 .picking-row2 {
            display: flex;
            align-items: center;
            gap: 8px;
            padding-left: 22px;
        }
        
        #card5 .picking-badge {
            min-width: 38px;
            height: 24px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 700;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        #card5 .picking-badge.urgent {
            background: #DC2626;
        }
        
        #card5 .picking-badge.warning {
            background: #F59E0B;
        }
        
        #card5 .picking-expiry-date {
            font-size: 12px;
            font-weight: 600;
            color: #6B7280;
            margin-left: auto;
            flex-shrink: 0;
        }
        
        #card5 .picking-location {
            font-size: 13px;
            font-weight: 700;
            color: #7C3AED;
            background: #F5F3FF;
            padding: 2px 6px;
            border-radius: 4px;
        }
        
        #card5 .picking-name {
            font-size: 13px;
            font-weight: 600;
            color: #1F2937;
        }
        
        #card5 .picking-expiry {
            font-size: 14px;
            font-weight: 700;
            color: #DC2626;
        }
        
        #card5 .picking-ratio {
            font-size: 13px;
            font-weight: 700;
            color: #DC2626;
            background: #FEE2E2;
            padding: 2px 8px;
            border-radius: 4px;
        }
        
        .item-location {
            font-size: 13px;
            font-weight: 700;
            color: #7C3AED;
            background: #F5F3FF;
            padding: 2px 6px;
            border-radius: 4px;
        }
        
        .item-details .ratio {
            font-weight: 600;
            color: #DC2626;
            background: #FEE2E2;
            padding: 2px 5px;
            border-radius: 3px;
        }
        
        /* ========================================
           카드 4: 스케줄
           ======================================== */
        .schedule-content-main {
            flex: 1;
            overflow-y: auto;
            padding: 5px;
        }
        
        .schedule-group {
            margin-bottom: 12px;
        }
        
        .group-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: bold;
            margin-bottom: 8px;
            padding-bottom: 6px;
        }
        
        .group-title-text {
            flex: 1;
        }
        
        .group-count {
            font-size: 11px;
            background: #E8EAED;
            padding: 2px 8px;
            border-radius: 10px;
            color: #666;
            font-weight: normal;
        }
        
        /* 오늘 그룹 - 강조 */
        .schedule-group.today {
            background: linear-gradient(135deg, #FFFACD 0%, #FFF9E6 100%);
            padding: 12px;
            border-radius: 8px;
            border: 2px solid #FFD700;
        }
        
        .schedule-group.today .group-title {
            font-size: 16px;
            color: #FF8C00;
            border-bottom: 2px solid #FFD700;
        }
        
        .schedule-group.today .group-count {
            background: #FFD700;
            color: #333;
            font-weight: bold;
        }
        
        /* 내일 그룹 */
        .schedule-group.tomorrow {
            background: linear-gradient(135deg, #E6F3FF 0%, #F0F8FF 100%);
            padding: 10px;
            border-radius: 8px;
            border: 2px solid #B0D4FF;
        }
        
        .schedule-group.tomorrow .group-title {
            font-size: 14px;
            color: #1E90FF;
            border-bottom: 1px solid #B0D4FF;
        }
        
        .schedule-group.tomorrow .group-count {
            background: #B0D4FF;
            color: #333;
        }
        
        /* 이번 주 그룹 */
        .schedule-group.this-week {
            background: white;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #E8EAED;
        }
        
        .schedule-group.this-week .group-title {
            font-size: 13px;
            color: #3B4458;
            border-bottom: 1px solid #E8EAED;
        }
        
        /* 이벤트 리스트 */
        .event-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 8px;
        }
        
        .event-item {
            display: flex;
            align-items: center;
            padding: 6px 8px;
            font-size: 13px;
            line-height: 1.4;
            border-radius: 6px;
            transition: all 0.2s ease;
            background: rgba(255, 255, 255, 0.5);
        }
        
        .event-item:hover {
            background: rgba(255, 255, 255, 0.9);
            transform: translateX(3px);
        }
        
        .event-icon {
            font-size: 18px;
            margin-right: 10px;
            min-width: 24px;
            flex-shrink: 0;
            text-align: center;
        }
        
        .event-text {
            color: #333;
            flex: 1;
        }
        
        /* 유형별 색상 */
        .event-item.birthday .event-icon { color: #FF69B4; }
        .event-item.leave .event-icon { color: #87CEEB; }
        .event-item.education .event-icon { color: #FFA500; }
        .event-item.vacation .event-icon { color: #90EE90; }
        .event-item.other .event-icon { color: #C0C0C0; }
        
        .schedule-content-main::-webkit-scrollbar {
            width: 6px;
        }
        
        .schedule-content-main::-webkit-scrollbar-track {
            background: #F3F4F6;
            border-radius: 3px;
        }
        
        .schedule-content-main::-webkit-scrollbar-thumb {
            background: #D1D5DB;
            border-radius: 3px;
        }
        
        .schedule-content-main::-webkit-scrollbar-thumb:hover {
            background: #9CA3AF;
        }
        
        /* ========================================
           카드 5 & 6: 출고 현황
           ======================================== */
        .outbound-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        /* 출하금액 영역 */
        .amount-section {
            text-align: center;
            padding-bottom: 15px;
            border-bottom: 2px solid #E8EAED;
            margin-bottom: 15px;
        }
        
        .amount-section.card3-amount {
            padding-bottom: 15px;
            margin-bottom: 15px;
        }
        
        .amount-label {
            font-size: 14px;
            color: #666;
            margin-bottom: 8px;
        }
        
        .amount-value {
            font-size: 32px;
            font-weight: bold;
            color: #3B4458;
            margin-bottom: 12px;
        }
        
        /* 라벨 건수 영역 (카드5) */
        .label-section-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        
        .label-section {
            text-align: center;
            padding: 2px 0 18px 0;
            border-bottom: 1px solid #E8EAED;
        }
        
        .label-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .label-text {
            font-size: 14px;
            color: #666;
        }
        
        .label-value {
            font-size: 32px;
            font-weight: bold;
            color: #3B4458;
        }
        
        .label-value.success {
            color: #60CB2E;
        }
        
        .label-value.danger {
            color: #F05E5E;
        }
        
        /* 비정형 라벨 - 2줄 구조 */
        .irregular-section {
            text-align: center;
            padding: 10px 0;
        }
        
        .irregular-total {
            margin-bottom: 8px;
        }
        
        .irregular-unprinted {
            font-size: 16px;
            font-weight: 600;
        }
        
        .irregular-unprinted.success {
            color: #60CB2E;
        }
        
        .irregular-unprinted.warning {
            color: #F59E0B;
        }
        
        /* 미발행 피킹리스트 영역 (카드3) */
        .picking-section-card3 {
            text-align: center;
            padding: 0px 0 16px 0;
            border-bottom: 2px solid #E8EAED;
            margin-bottom: 10px;
        }
        
        .picking-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .picking-text {
            font-size: 14px;
            color: #666;
        }
        
        .picking-value {
            font-size: 32px;
            font-weight: bold;
        }
        
        .picking-value.success {
            color: #60CB2E;
        }
        
        .picking-value.danger {
            color: #F05E5E;
        }
        
        /* 카드3 긴급알림 스타일 */
        .urgent-border {
            border: 4px solid #F05E5E !important;
            background: #FFE5E5 !important;
            animation: pulse-border 0.8s infinite;
            box-shadow: 0 0 20px rgba(240, 94, 94, 0.6);
        }
        
        @keyframes pulse-border {
            0%, 100% { 
                border-color: #F05E5E; 
                background: #FFE5E5;
                box-shadow: 0 0 20px rgba(240, 94, 94, 0.6);
            }
            50% { 
                border-color: #FF3333; 
                background: #FFCCCC;
                box-shadow: 0 0 40px rgba(255, 51, 51, 0.9);
            }
        }
        
        .unprinted-qty {
            color: #F05E5E;
            font-weight: bold;
        }
        
        /* 긴급알림 팝업 */
        .urgent-popup {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }
        
        .urgent-popup-content {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            border: 3px solid #F05E5E;
            border-radius: 20px;
            padding: 40px 60px;
            text-align: center;
            box-shadow: 0 0 50px rgba(240, 94, 94, 0.5);
            animation: popup-appear 0.3s ease-out;
        }
        
        @keyframes popup-appear {
            from { transform: scale(0.8); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        
        .urgent-popup-title {
            font-size: 48px;
            color: #F05E5E;
            margin-bottom: 20px;
        }
        
        .urgent-popup-message {
            font-size: 32px;
            color: #FFFFFF;
            margin-bottom: 15px;
        }
        
        .urgent-popup-dest {
            font-size: 40px;
            color: #FFD700;
            font-weight: bold;
            margin-bottom: 30px;
        }
        
        .urgent-popup-close {
            font-size: 20px;
            color: #9CA3AF;
            cursor: pointer;
        }
        
        .urgent-popup-close:hover {
            color: #FFFFFF;
        }

        /* 배송처별 수량 영역 (카드6) */
        .destination-section {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 3px 12px;
            font-size: 13px;
        }
        
        .destination-item {
            display: flex;
            align-items: center;
